# Playwright E2E Test Environment Variables
# Copy this file to .env.local and fill in your actual values

# =============================================================================
# SUPABASE CONFIGURATION (Required)
# =============================================================================

# Your Supabase project URL
# Find this in: Supabase Dashboard → Project Settings → API → Project URL
# Example: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here

# Supabase service role key (for admin operations like creating test users)
# Find this in: Supabase Dashboard → Project Settings → API → service_role key
# ⚠️  WARNING: Keep this secret! Never commit to version control!
# This key has admin privileges and bypasses Row Level Security
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase anon/public key (for client-side operations)
# Find this in: Supabase Dashboard → Project Settings → API → anon/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================================
# MODAL CONFIGURATION (Required for batch processing)
# =============================================================================

# Modal API endpoint URL for batch processing
# This should point to your deployed Modal function
# Example: https://scaile--bulk-gpt-processor-mvp-fastapi-app.modal.run
MODAL_API_URL=your-modal-api-url-here

# =============================================================================
# GEMINI CONFIGURATION (Required for AI features)
# =============================================================================

# Google Gemini API key for AI-powered job optimization
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# =============================================================================
# TEST USER CREDENTIALS (Auto-created by scripts/create-test-user.ts)
# =============================================================================

# These are the default test user credentials used by Playwright
# You don't need to change these unless you want custom test credentials

# Test user email (must match scripts/create-test-user.ts)
TEST_USER_EMAIL=test@bulkgpt.local

# Test user password (must match scripts/create-test-user.ts)
TEST_USER_PASSWORD=Test123456!

# =============================================================================
# OPTIONAL: VERCEL DEPLOYMENT PROTECTION (For production E2E tests)
# =============================================================================

# Vercel deployment protection bypass token
# Only needed if running tests against Vercel preview deployments
# Find this in: Vercel Dashboard → Project Settings → Deployment Protection
# VERCEL_BYPASS_TOKEN=your-bypass-token-here

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================

# 1. Copy this file to .env.local:
#    cp .env.test.example .env.local
#
# 2. Fill in all required values (see comments above for where to find them)
#
# 3. Create the test user in Supabase:
#    npx tsx scripts/create-test-user.ts
#
# 4. Verify your environment is ready:
#    npx tsx scripts/verify-test-env.ts
#
# 5. Run Playwright tests:
#    npm run test:e2e
#
# For detailed testing documentation, see: docs/TESTING.md
